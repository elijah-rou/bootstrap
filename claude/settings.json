{
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true
  },
  "statusLine": {
    "type": "command",
    "command": "bun @AGENT_KIT@/claude/statusline.ts",
    "refreshInterval": 60
  },
  "env": {
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh @AGENT_KIT@/agentic/bin/claude-hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
