{
  "subagentPromptCacheTtl": "1h",
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true
  },
  "statusLine": {
    "type": "command",
    "command": "bun @AGENT_KIT@/claude/statusline.ts",
    "refreshInterval": 60
  },
  "env": {
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"@BOOTSTRAP_ROOT@/repo/bin/agent-kit-lag\" || \"@BOOTSTRAP_ROOT@/repo/bin/agent-kit-lag\" \"@BOOTSTRAP_ROOT@\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f @AGENT_KIT@/agentic/tools/jev/cli.ts || bun @AGENT_KIT@/agentic/tools/jev/cli.ts task-class --claude-hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
