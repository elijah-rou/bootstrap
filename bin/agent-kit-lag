#!/usr/bin/env bash
# Claude Code's SessionStart hook (claude/settings.json): prints one warning, as hook JSON, when the
# installed agent-kit is behind its origin/main. The check reads only local refs and never waits on
# the network. At most once an hour it then refreshes origin/main in the background, bounded by a
# watchdog, so a later session sees new commits. Every failure is silent; the hook always exits 0.
# Usage: agent-kit-lag BOOTSTRAP_ROOT
set -u
root="${1:?usage: agent-kit-lag BOOTSTRAP_ROOT}"
kit="$root/tools/agent-kit"
stamp="$kit/.git/bootstrap-kit-lag"
refresh_minutes=60
fetch_seconds=30

# A development checkout linked with BOOTSTRAP_AGENT_KIT is the developer's own: never checked or fetched.
[[ ! -L "$kit" && -d "$kit/.git" ]] || exit 0

behind="$(git -C "$kit" rev-list --count HEAD..refs/remotes/origin/main 2>/dev/null)"
installed="$(git -C "$kit" rev-parse HEAD 2>/dev/null)"
main="$(git -C "$kit" rev-parse refs/remotes/origin/main 2>/dev/null)"
# The message holds only a count and two commit ids, so it is valid JSON without escaping.
# The fix is a pin pull request reviewed in bootstrap, opened by scripts/pin-agent-kit from a clone of
# bootstrap. The advice names no path under $root: $root/repo may link to any checkout, such as
# another repository's detached copy of bootstrap.
if [[ "$behind" =~ ^[1-9][0-9]*$ && "$installed" =~ ^[0-9a-f]{40,64}$ && "$main" =~ ^[0-9a-f]{40,64}$ ]]; then
    commits=commits
    if [[ "$behind" == 1 ]]; then commits=commit; fi
    advice="Run scripts/pin-agent-kit from a bootstrap clone to open the pin PR."
    printf '{"systemMessage": "agent-kit is %s %s behind origin/main (installed %s, main %s). %s"}\n' \
        "$behind" "$commits" "${installed:0:7}" "${main:0:7}" "$advice"
fi

# The stamp is taken before the fetch starts, so sessions starting together fetch once and an
# unreachable remote is retried an hour later rather than on every session.
[[ -z "$(find "$stamp" -mmin "-$refresh_minutes" 2>/dev/null)" ]] || exit 0
touch "$stamp" 2>/dev/null || exit 0
# Job control gives the refresh its own process group, so it outlives the hook's. On timeout the
# watchdog kills that whole group, which takes git's transport children (ssh, git-remote-https) with
# the fetch. Credential prompts of every kind are off: nobody is there to answer them.
set -m
(
    set +m
    group="$(exec sh -c 'echo "$PPID"')"
    GIT_TERMINAL_PROMPT=0 GIT_ASKPASS='' SSH_ASKPASS='' GIT_SSH_COMMAND='ssh -oBatchMode=yes' \
        git -C "$kit" -c credential.helper= -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 \
        fetch --quiet --no-tags --no-write-fetch-head origin +refs/heads/main:refs/remotes/origin/main &
    fetch=$!
    (
        sleep "$fetch_seconds" &
        sleeper=$!
        trap 'kill "$sleeper"; exit 0' TERM
        # Without job control there is no group led by the refresh, so only the fetch is killed.
        wait "$sleeper" && { kill -TERM -- "-$group" || kill "$fetch"; }
    ) &
    watchdog=$!
    wait "$fetch"
    kill "$watchdog"
) </dev/null >/dev/null 2>&1 &
exit 0
