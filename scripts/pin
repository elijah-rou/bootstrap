#!/usr/bin/env bash
# Moves the catalog rows for NAME that carry its pinned version to VERSION: rewrites the version
# in each URL and records the new sha256 (from the GitHub release API when available, otherwise
# by downloading).
# Usage: scripts/pin NAME VERSION
set -euo pipefail
name="${1:?usage: scripts/pin NAME VERSION}"
version="${2:?usage: scripts/pin NAME VERSION}"
catalog="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/catalog.tsv"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

digest() {
    local url="$1" repository tag asset
    if [[ "$url" =~ ^https://github\.com/([^/]+/[^/]+)/releases/download/([^/]+)/([^/]+)$ ]]; then
        repository="${BASH_REMATCH[1]}" tag="${BASH_REMATCH[2]}" asset="${BASH_REMATCH[3]}"
        gh api "repos/$repository/releases/tags/$tag" --jq ".assets[] | select(.name == \"$asset\") | .digest" | sed 's/^sha256://'
    else
        curl --fail --location --silent --show-error --output "$work/artifact" "$url"
        if command -v sha256sum >/dev/null; then sha256sum "$work/artifact"; else shasum -a 256 "$work/artifact"; fi | awk '{ print $1 }'
    fi
}

# The pinned version is the one the name's download rows carry. Other rows of the same name keep
# their own versions: python pins uv downloads and, separately, the CPython that uv installs.
pinned="$(awk -F '\t' -v name="$name" '$0 !~ /^#/ && $1 == name && $6 ~ /^https:/ { print $3; exit }' "$catalog")"
found=0
while IFS= read -r line; do
    IFS=$'\t' read -r row_name groups old platform sha source bins <<<"$line"
    if [[ "$line" == \#* || "$row_name" != "$name" || "$old" == - || ( -n "$pinned" && "$old" != "$pinned" ) ]]; then printf '%s\n' "$line"; continue; fi
    found=1
    source="${source//"$old"/$version}"
    if [[ "$source" == https://* ]]; then
        sha="$(digest "$source")"
        [[ "$sha" =~ ^[0-9a-f]{64}$ ]] || { printf 'no sha256 for %s\n' "$source" >&2; exit 1; }
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$row_name" "$groups" "$version" "$platform" "$sha" "$source" "$bins"
done <"$catalog" >"$work/catalog"
[[ "$found" == 1 ]] || { printf 'no pinned rows for %s\n' "$name" >&2; exit 1; }
cat "$work/catalog" >"$catalog"
git -C "$(dirname "$catalog")" diff --stat -- catalog.tsv
