#!/usr/bin/env bash
# Checks that the generated-body marker in pi/agents/autopilot-owner.md names the agent-kit commit
# catalog.tsv pins. scripts/pin-agent-kit writes the catalog row, the body, and the marker together, so
# a mismatch means the pin moved without the role (or the role without the pin).
# Usage: scripts/check-agent-kit-role
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
role=pi/agents/autopilot-owner.md
pinned="$(awk -F '\t' '$0 !~ /^#/ && $1 == "agent-kit" { print $3; exit }' catalog.tsv)"
marked="$(sed -nE 's,^# Body generated by scripts/pin-agent-kit from agent-kit ([0-9a-f]{40}) .*,\1,p' "$role")"
if [[ ! "$pinned" =~ ^[0-9a-f]{40}$ || "$marked" != "$pinned" ]]; then
    printf '%s: body generated from agent-kit %s, but catalog.tsv pins %s; move both with scripts/pin-agent-kit\n' \
        "$role" "${marked:-(no marker)}" "${pinned:-(no agent-kit row)}" >&2
    exit 1
fi
