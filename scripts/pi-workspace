#!/usr/bin/env bash
set -euo pipefail

# Installed launchers load their owned runtime even in an unconfigured shell.
if [[ -f "$HOME/.config/dotfiles/bare-env.sh" ]]; then
    # shellcheck source=scripts/bare-env.sh
    source "$HOME/.config/dotfiles/bare-env.sh"
    [[ -x "$DOTFILES_BARE_ROOT/bin/pi" ]] || { printf 'Owned Pi entrypoint is missing\n' >&2; exit 1; }
fi

WORKTREE_HOME="${PIW_WORKTREE_HOME:-${PI_WORKTREE_HOME:-$HOME/piw-worktrees}}"
REGISTRY_FILE="$WORKTREE_HOME/registry.json"
LOCK_DIR="$WORKTREE_HOME/.registry.lock"
LOCK_TIMEOUT_SECONDS=5
LOCK_STALE_SECONDS=30

usage() {
    cat <<'EOF'
Usage: piw [workspace option] [--] [pi args...]
       pi-workspace [workspace option] [--] [pi args...]

Workspace options:
  --main                 Launch pi in the current repo checkout root.
  --worktree <query>     Launch pi in a managed worktree matching id, label, branch, or path.
  --new [label]          Create a managed worktree for this repo, then launch pi there.
  --list                 List managed worktrees for this repo and exit.
  -h, --help             Show help.

No workspace option opens an interactive picker when stdin is a TTY. Otherwise it defaults to --main.
EOF
}

fail() {
    printf 'pi-workspace: %s\n' "$1" >&2
    exit 1
}

slugify() {
    local value="$1"
    local fallback="$2"
    local slug
    slug=$(printf '%s' "$value" \
        | tr '[:upper:]' '[:lower:]' \
        | sed -E 's/[^a-z0-9._-]+/-/g; s/-+/-/g; s/^[._-]+//; s/[._-]+$//' \
        | cut -c 1-48)
    if [[ -z "$slug" ]]; then
        printf '%s' "$fallback"
    else
        printf '%s' "$slug"
    fi
}

resolve_git_root() {
    git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || fail "not inside a git repo"
}

resolve_git_common_dir() {
    local repo_root="$1"
    local common_dir
    common_dir=$(git -C "$repo_root" rev-parse --git-common-dir 2>/dev/null) || fail "failed to resolve git common dir"
    if [[ "$common_dir" = /* ]]; then
        printf '%s' "$common_dir"
    else
        printf '%s/%s' "$repo_root" "$common_dir"
    fi
}

ensure_clean_checkout() {
    local repo_root="$1"
    local status
    status=$(git -C "$repo_root" status --porcelain=v1 --untracked-files=all)
    if [[ -n "$status" ]]; then
        fail "checkout is dirty; commit/stash/clean before creating a worktree"
    fi
}

with_registry_lock() {
    local started now lock_mtime
    mkdir -p "$WORKTREE_HOME"
    started=$(date +%s)
    while ! mkdir "$LOCK_DIR" 2>/dev/null; do
        now=$(date +%s)
        if lock_mtime=$(stat -f %m "$LOCK_DIR" 2>/dev/null || stat -c %Y "$LOCK_DIR" 2>/dev/null); then
            if (( now - lock_mtime > LOCK_STALE_SECONDS )); then
                rm -rf "$LOCK_DIR"
                continue
            fi
        fi
        if (( now - started > LOCK_TIMEOUT_SECONDS )); then
            fail "timed out waiting for registry lock: $LOCK_DIR"
        fi
        sleep 0.05
    done
    set +e
    "$@"
    local code=$?
    set -e
    rmdir "$LOCK_DIR" 2>/dev/null || true
    return "$code"
}

list_records() {
    local repo_root="$1"
    local repo_common_dir="$2"
    node - "$REGISTRY_FILE" "$repo_root" "$repo_common_dir" <<'NODE'
const fs=require('node:fs'); const [file,root,common]=process.argv.slice(2); let registry={entries:[]};
try{registry=JSON.parse(fs.readFileSync(file,'utf8'))}catch(error){if(error.code!=='ENOENT')throw error}
for(const entry of registry.entries||[]){const path=entry.worktreePath||'';if(entry.status==='active'&&path&&fs.existsSync(path)&&(entry.repoCommonDir===common||entry.repoRoot===root))console.log([entry.id||'',entry.label||'',entry.branch||'',path,entry.updatedAt||''].join('\t'))}
NODE
}

print_records() {
    local repo_root="$1"
    local repo_common_dir="$2"
    local records
    records=$(list_records "$repo_root" "$repo_common_dir")
    if [[ -z "$records" ]]; then
        printf 'No managed worktrees for %s\n' "$repo_root"
        return
    fi
    printf '%s\n' "$records" | awk -F '\t' '{ printf "%s  %s  %s\n    %s\n", $1, $2, $3, $4 }'
}

record_env_for_path() {
    local repo_root="$1"
    local repo_common_dir="$2"
    local path="$3"
    list_records "$repo_root" "$repo_common_dir" | awk -F '\t' -v p="$path" '$4 == p { print $1 "\t" $2; exit }'
}

find_record_path() {
    local repo_root="$1"
    local repo_common_dir="$2"
    local query="$3"
    local matches count
    matches=$(list_records "$repo_root" "$repo_common_dir" | awk -F '\t' -v q="$query" '
        index($1, q) == 1 || index(tolower($2), tolower(q)) || index(tolower($3), tolower(q)) || index(tolower($4), tolower(q)) { print }
    ')
    count=$(printf '%s\n' "$matches" | sed '/^$/d' | wc -l | tr -d ' ')
    if [[ "$count" == "0" ]]; then
        fail "no managed worktree matches: $query"
    fi
    if [[ "$count" == "1" ]]; then
        printf '%s\n' "$matches" | awk -F '\t' 'NF { print $4; exit }'
        return
    fi
    if [[ -t 0 ]]; then
        choose_existing_from_records "$matches"
        return
    fi
    printf '%s\n' "$matches" >&2
    fail "multiple worktrees match: $query"
}

choose_existing_from_records() {
    local records="$1"
    local selected
    if command -v fzf >/dev/null 2>&1; then
        selected=$(printf '%s\n' "$records" | fzf --prompt='worktree> ' --with-nth=2,3,4 --delimiter=$'\t') || exit 130
        printf '%s\n' "$selected" | awk -F '\t' '{ print $4 }'
        return
    fi

    local i=1
    local lines=()
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        lines+=("$line")
        printf '%d) %s\n' "$i" "$(printf '%s' "$line" | awk -F '\t' '{ printf "%s %s %s", $2, $3, $4 }')" >&2
        i=$((i + 1))
    done <<< "$records"
    local choice
    read -r -p 'Select worktree: ' choice
    [[ "$choice" =~ ^[0-9]+$ ]] || fail "invalid selection"
    (( choice >= 1 && choice <= ${#lines[@]} )) || fail "selection out of range"
    printf '%s\n' "${lines[$((choice - 1))]}" | awk -F '\t' '{ print $4 }'
}

choose_workspace() {
    local repo_root="$1"
    local repo_common_dir="$2"
    local records options selected
    records=$(list_records "$repo_root" "$repo_common_dir")
    options=$'main\tmain checkout\t'"$repo_root"$'\t'"$repo_root"
    if [[ -n "$records" ]]; then
        options+=$'\n'
        options+=$(printf '%s\n' "$records" | awk -F '\t' '{ printf "worktree\t%s\t%s\t%s\t%s\n", $2, $3, $4, $1 }' | sed '$ s/$//')
    fi
    options+=$'\nnew\tnew worktree\tcreate under ~/piw-worktrees\t-'

    if command -v fzf >/dev/null 2>&1; then
        selected=$(printf '%s\n' "$options" | fzf --prompt='pi workspace> ' --with-nth=1,2,3,4 --delimiter=$'\t') || exit 130
    else
        local i=1
        local lines=()
        while IFS= read -r line; do
            lines+=("$line")
            printf '%d) %s\n' "$i" "$(printf '%s' "$line" | awk -F '\t' '{ printf "%s %s %s", $1, $2, $3 }')" >&2
            i=$((i + 1))
        done <<< "$options"
        local choice
        read -r -p 'Select workspace: ' choice
        [[ "$choice" =~ ^[0-9]+$ ]] || fail "invalid selection"
        (( choice >= 1 && choice <= ${#lines[@]} )) || fail "selection out of range"
        selected="${lines[$((choice - 1))]}"
    fi

    case "$(printf '%s' "$selected" | cut -f1)" in
        main) printf '%s\n' "$repo_root" ;;
        worktree) printf '%s\n' "$selected" | cut -f4 ;;
        new)
            local label
            read -r -p 'Worktree label: ' label
            create_worktree "$repo_root" "${label:-worktree}"
            ;;
        *) fail "unknown workspace selection" ;;
    esac
}

append_registry_record() {
    local record_json="$1"
    node - "$REGISTRY_FILE" "$record_json" <<'NODE'
const fs=require('node:fs');const [file,text]=process.argv.slice(2);let registry={version:1,entries:[]};try{registry=JSON.parse(fs.readFileSync(file,'utf8'))}catch(error){if(error.code!=='ENOENT')throw error}registry.version=1;registry.entries=registry.entries||[];registry.entries.unshift(JSON.parse(text));const temporary=`${file}.${process.pid}.tmp`;fs.writeFileSync(temporary,JSON.stringify(registry,null,2)+'\n',{mode:0o600});fs.renameSync(temporary,file);
NODE
}

create_worktree() {
    local repo_root="$1"
    local label="$2"
    ensure_clean_checkout "$repo_root"
    mkdir -p "$WORKTREE_HOME"

    local id repo_slug label_slug branch path repo_common_dir head_sha created_at record_json
    id=$(node -e 'console.log(require("node:crypto").randomUUID().slice(0,8))')
    repo_slug=$(slugify "$(basename "$repo_root")" repo)
    label_slug=$(slugify "$label" worktree)
    branch="pi/$repo_slug/$label_slug-$id"
    path="$WORKTREE_HOME/$repo_slug/$label_slug-$id"
    repo_common_dir=$(resolve_git_common_dir "$repo_root")

    if [[ -e "$path" ]]; then
        fail "worktree path already exists: $path"
    fi

    mkdir -p "$(dirname "$path")"
    git -C "$repo_root" worktree add -b "$branch" "$path" HEAD >&2
    head_sha=$(git -C "$path" rev-parse HEAD)
    created_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    record_json=$(node -e 'const [id,repoRoot,repoCommonDir,worktreePath,branch,headSha,label,createdFromCwd,createdAt]=process.argv.slice(1);console.log(JSON.stringify({id,status:"active",repoRoot,repoCommonDir,worktreePath,branch,baseRef:"HEAD",headSha,label,sessionId:null,sessionFile:null,createdFromCwd,createdAt,updatedAt:createdAt,ownerKind:"launcher"}))' "$id" "$repo_root" "$repo_common_dir" "$path" "$branch" "$head_sha" "$label_slug" "$PWD" "$created_at")
    with_registry_lock append_registry_record "$record_json"
    export PI_WORKTREE_RECORD_ID="$id"
    export PI_WORKSPACE_LABEL="$label_slug"
    printf '%s\n' "$path"
}

workspace_mode="interactive"
workspace_query=""
new_label=""
pi_args=()

while (($# > 0)); do
    case "$1" in
        --main)
            workspace_mode="main"
            shift
            ;;
        --worktree)
            workspace_mode="worktree"
            shift
            [[ $# -gt 0 ]] || fail "--worktree requires a query"
            workspace_query="$1"
            shift
            ;;
        --new)
            workspace_mode="new"
            shift
            if [[ $# -gt 0 && "$1" != --* ]]; then
                new_label="$1"
                shift
            fi
            ;;
        --list)
            workspace_mode="list"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            pi_args=("$@")
            break
            ;;
        *)
            pi_args=("$@")
            break
            ;;
    esac
done

repo_root=$(resolve_git_root)
repo_common_dir=$(resolve_git_common_dir "$repo_root")
workspace_path=""

case "$workspace_mode" in
    main)
        workspace_path="$repo_root"
        export PI_WORKSPACE_MODE="main"
        ;;
    worktree)
        workspace_path=$(find_record_path "$repo_root" "$repo_common_dir" "$workspace_query")
        export PI_WORKSPACE_MODE="worktree"
        ;;
    new)
        if [[ -z "$new_label" ]]; then
            if [[ -t 0 ]]; then
                read -r -p 'Worktree label: ' new_label
            else
                new_label="worktree"
            fi
        fi
        workspace_path=$(create_worktree "$repo_root" "$new_label")
        export PI_WORKSPACE_MODE="worktree"
        ;;
    list)
        print_records "$repo_root" "$repo_common_dir"
        exit 0
        ;;
    interactive)
        if [[ ! -t 0 ]]; then
            workspace_path="$repo_root"
            export PI_WORKSPACE_MODE="main"
        else
            workspace_path=$(choose_workspace "$repo_root" "$repo_common_dir")
            if [[ "$workspace_path" == "$repo_root" ]]; then
                export PI_WORKSPACE_MODE="main"
            else
                export PI_WORKSPACE_MODE="worktree"
            fi
        fi
        ;;
    *)
        fail "unknown mode: $workspace_mode"
        ;;
esac

[[ -d "$workspace_path" ]] || fail "workspace path does not exist: $workspace_path"
export PI_WORKSPACE_PATH="$workspace_path"
export PI_WORKSPACE_REPO_ROOT="$repo_root"

if [[ "${PI_WORKSPACE_MODE:-}" == "worktree" && -z "${PI_WORKTREE_RECORD_ID:-}" ]]; then
    record_env=$(record_env_for_path "$repo_root" "$repo_common_dir" "$workspace_path")
    if [[ -n "$record_env" ]]; then
        record_id=$(printf '%s' "$record_env" | cut -f1)
        record_label=$(printf '%s' "$record_env" | cut -f2)
        export PI_WORKTREE_RECORD_ID="$record_id"
        export PI_WORKSPACE_LABEL="$record_label"
    fi
fi

cd "$workspace_path"
exec pi "${pi_args[@]}"
