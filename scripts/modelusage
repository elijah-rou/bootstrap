#!/usr/bin/env node
import { spawnSync } from 'node:child_process';
import { hostname } from 'node:os';

function fail(message, code=2){console.error(`modelusage: ${message}`);process.exit(code)}
const options={hosts:process.env.MODELUSAGE_HOSTS||'localhost',since:new Date().toISOString().slice(0,10),until:new Date().toISOString().slice(0,10),timeout:45,period:'daily',format:'box'};
for(let i=2;i<process.argv.length;i++){const key=process.argv[i];if(!['--hosts','--since','--until','--timeout','--period','--format'].includes(key)||i+1>=process.argv.length)fail(`unknown or incomplete argument: ${key}`);options[key.slice(2)]=process.argv[++i]}
options.timeout=Number(options.timeout);if(!Number.isInteger(options.timeout)||options.timeout<1||options.timeout>3600)fail('--timeout must be 1..3600');
if(!/^\d{4}-\d{2}-\d{2}$/.test(options.since)||!/^\d{4}-\d{2}-\d{2}$/.test(options.until))fail('dates must use YYYY-MM-DD');
if(!['daily','weekly','monthly','yearly'].includes(options.period)||!['box','markdown','csv','json'].includes(options.format))fail('invalid period or format');
const localNames=new Set(['localhost','127.0.0.1','::1',hostname().toLowerCase(),hostname().toLowerCase().split('.')[0]]);
const hosts=[];for(const raw of options.hosts.split(',').map(v=>v.trim()).filter(Boolean)){const host=localNames.has(raw.toLowerCase().split('.')[0])?hostname().toLowerCase().split('.')[0]:raw;if(!hosts.some(v=>v.toLowerCase()===host.toLowerCase()))hosts.push(host)}if(!hosts.length)fail('at least one host is required');
function entries(payload){if(!payload)return[];if(Array.isArray(payload))return payload.filter(v=>v&&typeof v==='object');return Array.isArray(payload.daily)?payload.daily:[]}
function rows(payload,host,source){const result=[];for(const day of entries(payload)){let models=day.modelBreakdowns||day.modelBreakdown;if(!Array.isArray(models)||!models.length)models=[{...day,modelName:Array.isArray(day.modelsUsed)?day.modelsUsed.join(', '):'(unknown)'}];for(const model of models){if(!model||typeof model!=='object')continue;let name=String(model.modelName||model.model||'(unknown)');if(source==='claude-code'&&!name.startsWith('[cc] '))name=`[cc] ${name}`;result.push({host,source,date:String(day.date||''),model:name,input_tokens:Number(model.inputTokens||0),output_tokens:Number(model.outputTokens||0),cache_creation_tokens:Number(model.cacheCreationTokens||0),cache_read_tokens:Number(model.cacheReadTokens||0),cost_usd:Number(model.cost??model.totalCost??model.costUSD??0)})}}return result}
const warnings=[],collected=[];for(const host of hosts){const local=host===hostname().toLowerCase().split('.')[0];for(const [source,command] of [['pi',`ccusage-pi daily --json --breakdown --since ${options.since} --until ${options.until}`],['claude-code',`ccusage daily --json --breakdown --offline --since ${options.since.replaceAll('-','')} --until ${options.until.replaceAll('-','')}`]]){const argv=local?['bash','-lc',command]:['ssh','-o','BatchMode=yes','-o','ConnectTimeout=8',host,command];const child=spawnSync(argv[0],argv.slice(1),{encoding:'utf8',timeout:options.timeout*1000,maxBuffer:16*1024*1024});if(child.error?.code==='ETIMEDOUT'){warnings.push(`${host} ${source}: timeout`);continue}if(child.status!==0){const error=(child.stderr||'').trim();if(!error.includes('command not found: ccusage-pi')&&!error.includes('No valid Claude data directories found'))warnings.push(`${host} ${source}: exit ${child.status}: ${error.split('\n')[0]?.slice(0,160)||'(no stderr)'}`);continue}try{collected.push(...rows((child.stdout||'').trim()?JSON.parse(child.stdout):null,host,source))}catch(error){warnings.push(`${host} ${source}: invalid JSON: ${error.message}`)}}}
const map=new Map();for(const row of collected){const key=[row.date,row.host,row.source,row.model].join('\0');const total=map.get(key)||{...row,input_tokens:0,output_tokens:0,cache_creation_tokens:0,cache_read_tokens:0,cost_usd:0};for(const name of ['input_tokens','output_tokens','cache_creation_tokens','cache_read_tokens','cost_usd'])total[name]+=row[name];map.set(key,total)}const output=[...map.values()].sort((a,b)=>[a.date,a.host,a.source,a.model].join('\0').localeCompare([b.date,b.host,b.source,b.model].join('\0')));
if(options.format==='json')console.log(JSON.stringify(output,null,2));else if(options.format==='csv'){console.log('date,host,source,model,input_tokens,output_tokens,cache_creation_tokens,cache_read_tokens,cost_usd');for(const r of output)console.log([r.date,r.host,r.source,r.model,r.input_tokens,r.output_tokens,r.cache_creation_tokens,r.cache_read_tokens,r.cost_usd.toFixed(6)].map(v=>`"${String(v).replaceAll('"','""')}"`).join(','))}else{console.log('| date | host | source | model | input | output | cache create | cache read | cost USD |');console.log('|---|---|---|---|---:|---:|---:|---:|---:|');for(const r of output)console.log(`| ${r.date} | ${r.host} | ${r.source} | ${r.model} | ${r.input_tokens} | ${r.output_tokens} | ${r.cache_creation_tokens} | ${r.cache_read_tokens} | ${r.cost_usd.toFixed(4)} |`);console.log(`\nTotal cost: $${output.reduce((n,r)=>n+r.cost_usd,0).toFixed(4)}`)}
for(const warning of warnings)console.error(`warn: ${warning}`);process.exitCode=output.length?0:2;
