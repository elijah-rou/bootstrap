#!/usr/bin/env bash
# Static checks and Pi configuration tests (needs Bun, shellcheck, and Python). The install round-trip is
# tests/container.sh.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

git diff --check
python3 scripts/check-public-safety --index
python3 scripts/check-public-safety --worktree

shell_files=(install.sh bin/pi bin/codex bin/node bin/pi-workspace shell/env.sh shell/bashrc shell/common.sh
    shell/open.sh tests/roundtrip.sh tests/container.sh tests/uninstall_edges.sh scripts/pin scripts/validate)
for file in "${shell_files[@]}"; do bash -n "$file"; done
if command -v zsh >/dev/null; then zsh -n shell/zshrc; fi
shellcheck -x -P SCRIPTDIR --severity=warning "${shell_files[@]}"

# Catalog rows: seven fields, and every download pinned by sha256.
awk -F '\t' '
    /^#/ || NF == 0 { next }
    NF != 7 { printf "catalog.tsv:%d: expected 7 fields, found %d\n", NR, NF; bad = 1 }
    $6 ~ /^https:\/\// && $5 !~ /^[0-9a-f]{64}$/ { printf "catalog.tsv:%d: download without sha256\n", NR; bad = 1 }
    END { exit bad }
' catalog.tsv

# Node keeps the arguments after `-e` and `-p` code; install.sh and pi-workspace rely on it.
[[ "$(bin/node -e 'console.log(process.argv.slice(1).join(","))' a b)" == a,b ]] || { echo "bin/node -e drops arguments" >&2; exit 1; }
[[ "$(bin/node -p 'process.argv.slice(1).join(",")' a b)" == a,b ]] || { echo "bin/node -p drops arguments" >&2; exit 1; }

bash tests/uninstall_edges.sh

# Pi configuration contract tests; Bun runs their node:test suites.
bun test pi/tests
