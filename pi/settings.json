{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "theme": "iroaseta",
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "npmCommand": [
    "bun"
  ],
  "packages": [
    "git:github.com/elijah-rou/pi-subagents@38ddf4c694c3cc3d2b453bd44ca3071b104873ee",
    "npm:pi-web-access@0.35.0",
    "npm:@lolipopshock/pi-clm@1.0.0",
    "git:github.com/elijah-rou/pi-privileged-operations@8728b268bc8d1cc31d7e0f4b51a74974fc72216d",
    "git:github.com/elijah-rou/pi-sub-limits@b968a179c05d323f8fea126ba3ad3e5fdf1cfc09",
    "git:github.com/elijah-rou/pi-effort@9400dcea4a591b90c994187432e3bdcd0f3fa4ff",
    "git:github.com/elijah-rou/pi-unveil@dee3a5dc9783b6c699b6c18001cad4658e8e794d",
    "@AGENT_KIT@"
  ],
  "subagents": {
    "maxSubagentDepth": 2,
    "defaultModel": "openai-codex/gpt-6.1-sol",
    "defaultThinking": "high",
    "agentOverrides": {
      "delegate": {
        "model": "openai-codex/gpt-5.6-luna",
        "fallbackModels": [
          "opencode/deepseek-v4-flash:high"
        ],
        "thinking": "high"
      },
      "worker": {
        "model": "openai-codex/gpt-6.1-sol",
        "fallbackModels": [
          "opencode/grok-4.6:high"
        ],
        "thinking": "medium",
        "defaultContext": "fresh",
        "inheritProjectContext": true,
        "inheritGlobalContext": true
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-luna",
        "fallbackModels": [
          "opencode/deepseek-v4-flash:high"
        ],
        "thinking": "medium"
      },
      "reviewer": {
        "model": "openai-codex/gpt-6.1-sol",
        "fallbackModels": [
          "opencode/grok-4.6:high"
        ],
        "thinking": "xhigh"
      },
      "oracle": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "high",
        "disabled": true
      },
      "oracle-eval": {
        "disabled": true
      },
      "oracle-investigate": {
        "disabled": true
      },
      "oracle-review": {
        "disabled": true
      },
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "fallbackModels": [
          "opencode/deepseek-v4-flash:high"
        ],
        "thinking": "low"
      }
    },
    "maxActiveAsyncRunsPerSession": 4,
    "perRunConcurrencyLimit": 6,
    "maxSubagentSpawnsPerRun": 16,
    "maxSubagentSpawnsPerSession": 32
  },
  "hideThinkingBlock": false,
  "showCacheMissNotices": true,
  "collapseChangelog": true,
  "quietStartup": true,
  "treeFilterMode": "all"
}
